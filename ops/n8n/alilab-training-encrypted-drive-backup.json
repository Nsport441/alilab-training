{
  "name": "AliLab Training - Encrypted Drive Backup",
  "nodes": [
    {
      "id": "alilab-backup-1",
      "name": "Run backup manually",
      "type": "n8n-nodes-base.manualTrigger",
      "parameters": {},
      "position": [
        -760,
        60
      ],
      "typeVersion": 1
    },
    {
      "id": "alilab-backup-2",
      "name": "Daily at 03:30 Tehran",
      "type": "n8n-nodes-base.scheduleTrigger",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 3 * * *"
            }
          ]
        }
      },
      "position": [
        -760,
        260
      ],
      "typeVersion": 1.2
    },
    {
      "id": "alilab-backup-3",
      "name": "Fetch encrypted backup",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://training.alilab.ir/api/ops/backup",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "position": [
        -520,
        160
      ],
      "typeVersion": 4.2,
      "credentials": {
        "httpHeaderAuth": {
          "name": "AliLab Training Backup"
        }
      }
    },
    {
      "id": "alilab-backup-4",
      "name": "Check envelope",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const item = $input.first();\nconst bytes = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst envelope = JSON.parse(bytes.toString('utf8'));\nif (envelope.format !== 'alilab-sealed-backup' || envelope.version !== 1 || envelope.keyId !== 'REPLACE_BACKUP_PUBLIC_KEY_ID' || !envelope.archive || !envelope.wrappedKey) throw new Error('Unexpected encrypted backup envelope');\nitem.json = { keyId: envelope.keyId, bytes: bytes.length };\nitem.binary = { original: item.binary.data };\nreturn [item];"
      },
      "position": [
        -280,
        160
      ],
      "typeVersion": 2
    },
    {
      "id": "alilab-backup-5",
      "name": "Upload encrypted archive",
      "type": "n8n-nodes-base.googleDrive",
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "original",
        "name": "={{ \"AliLab-Training-\" + $now.toFormat(\"yyyy-LL-dd_HH-mm-ss\") + \".alilab\" }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_DRIVE_FOLDER_ID"
        },
        "options": {}
      },
      "position": [
        -20,
        260
      ],
      "typeVersion": 3,
      "credentials": {
        "googleDriveOAuth2Api": {
          "name": "n8n Google Drive"
        }
      }
    },
    {
      "id": "alilab-backup-6",
      "name": "Download saved archive",
      "type": "n8n-nodes-base.googleDrive",
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {
          "binaryPropertyName": "downloaded"
        }
      },
      "position": [
        220,
        260
      ],
      "typeVersion": 3,
      "credentials": {
        "googleDriveOAuth2Api": {
          "name": "n8n Google Drive"
        }
      }
    },
    {
      "id": "alilab-backup-7",
      "name": "Compare inputs",
      "type": "n8n-nodes-base.merge",
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "position": [
        460,
        160
      ],
      "typeVersion": 3.2
    },
    {
      "id": "alilab-backup-8",
      "name": "Verify Drive copy",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const original = await this.helpers.getBinaryDataBuffer(0, 'original');\nconst downloaded = await this.helpers.getBinaryDataBuffer(0, 'downloaded');\nif (original.length !== downloaded.length || !original.equals(downloaded)) throw new Error('Drive readback differs from the encrypted source');\nconst uploaded = $('Upload encrypted archive').first().json;\nreturn [{ json: { ok: true, fileId: uploaded.id, fileName: uploaded.name, bytes: original.length, keyId: $('Check envelope').first().json.keyId, verifiedAt: $now.toISO() } }];"
      },
      "position": [
        700,
        160
      ],
      "typeVersion": 2
    },
    {
      "id": "alilab-backup-9",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "parameters": {
        "content": "## پیش‌نویس بک‌آپ رمزنگاری‌شده AliLab\n\nزمان پیشنهادی: هر روز ۰۳:۳۰ تهران.\n\nپیش از Publish:\n- مسیر بک‌آپ API باید با تأیید مالک فعال شود؛ پیش‌فرض آن خاموش است.\n- Credential نوع Header Auth با نام AliLab Training Backup را انتخاب کنید (Authorization).\n- اتصال n8n Google Drive را برای دو نود Drive انتخاب کنید.\n- کلید خصوصی بازیابی را خارج از n8n و Runflare نگه دارید.\n- اجرای دستی واقعی و تطبیق بایت‌های نسخهٔ Drive باید موفق شود.\n\nدر صورت خطا، اجرای n8n Failed می‌شود؛ فایل‌های قدیمی خودکار حذف نمی‌شوند.\n\nاین ورک‌فلو را پیش از تست واقعی Publish نکنید.",
        "height": 500,
        "width": 420
      },
      "position": [
        -300,
        -440
      ],
      "typeVersion": 1
    }
  ],
  "connections": {
    "Run backup manually": {
      "main": [
        [
          {
            "node": "Fetch encrypted backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily at 03:30 Tehran": {
      "main": [
        [
          {
            "node": "Fetch encrypted backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch encrypted backup": {
      "main": [
        [
          {
            "node": "Check envelope",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check envelope": {
      "main": [
        [
          {
            "node": "Upload encrypted archive",
            "type": "main",
            "index": 0
          },
          {
            "node": "Compare inputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload encrypted archive": {
      "main": [
        [
          {
            "node": "Download saved archive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download saved archive": {
      "main": [
        [
          {
            "node": "Compare inputs",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Compare inputs": {
      "main": [
        [
          {
            "node": "Verify Drive copy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "timezone": "Asia/Tehran",
    "executionOrder": "v1",
    "executionTimeout": 180,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false
  },
  "pinData": {}
}
