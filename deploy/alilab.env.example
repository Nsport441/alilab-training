# Staging behind TLS. Copy to .env; use a dedicated staging hostname for the first deployment.
RP_NAME=AliLab Training
RP_ID=training.alilab.ir
ORIGIN=https://training.alilab.ir
WEB_PORT=8080
NGINX_PORT=80
PORT=3000
BACKEND=api
RESOLVER=127.0.0.11
TRUST_PROXY=1
INVITE_ONLY=1
ALLOW_GUEST=0
PASSWORD_LOGIN=1
SESSION_DAYS=30
ADMIN_UIDS=
DEFAULT_LANG=en
COACH_DISABLED=1
MEDIA_UPLOADS=0
AUDIT_IP=off
AUDIT_MAX=5000
AUDIT_DAYS=90
APP_BUILD=phase1a-dev
# For Runflare, replace BACKEND and RESOLVER with verified private service/DNS values.
# Persian will become available in Phase 1B. Never set DEFAULT_LANG=fa before that.
